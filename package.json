{
  "name": "obsidian-smart-folders",
  "version": "0.1.0",
  "description": "Gives every folder a hidden .osf/ directory with frontmatter properties and folder-specific templates, plus a folder page view.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "install:vault": "node scripts/install-dev.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "install:test": "npm run build && OBSIDIAN_VAULT=/Users/harry/Desktop/OSFTestEnvironment node scripts/install-dev.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "folders",
    "frontmatter"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "1.14.4",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "yaml": "^2.8.0"
  }
}
